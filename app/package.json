{
  "name": "cc-cafe-app",
  "version": "0.5.0",
  "description": "Sims 4 mod manager for browsing, installing, and managing custom content.",
  "author": "CC Café",
  "homepage": "https://github.com/Chatgpt-cli-agent/cc-cafe",
  "private": true,
  "main": "dist-main/main.js",
  "scripts": {
    "dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "next build && tsc -p tsconfig.main.json && node scripts/copy-core.js",
    "start": "cross-env NODE_ENV=production electron .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "npm run build && electron-builder"
  },
  "dependencies": {
    "@nodebug/pngjs-image": "^1.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "adm-zip": "^0.5.17",
    "axios": "^1.15.2",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.16",
    "curseforge-api": "^1.3.0",
    "date-fns": "^4.1.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "jimp": "^1.6.1",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^16.6.6",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-virtuoso": "^4.18.6",
    "react-window": "^2.2.7",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "uleb128_33": "^1.3.7",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.10"
  }
}
