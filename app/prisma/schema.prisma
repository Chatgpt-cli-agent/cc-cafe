// CC Café Database Schema
// Prisma ORM configuration for PostgreSQL

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

/// Reports submitted by users for fake/suspicious mods
/// Each machine can only report a mod once (prevents spam)
model ModReport {
  id        String   @id @default(uuid())
  modId     Int      // CurseForge mod ID
  machineId String   // UUID of reporting machine (generated client-side)
  reason    String   // User-provided reason for report
  fakeScore Int      // Calculated fake score at time of report (0-100)
  createdAt DateTime @default(now())

  @@unique([modId, machineId]) // One report per machine per mod
  @@index([modId])
  @@index([machineId])
  @@map("mod_reports")
}

/// Mods that have been flagged with warnings
/// Warnings trigger after 3 reports OR automatic detection (no .package files)
model WarnedMod {
  id            String   @id @default(uuid())
  modId         Int      @unique // CurseForge mod ID
  reportCount   Int      @default(0) // Number of user reports
  isAutoWarned  Boolean  @default(false) // True if warning was automatic (no mod files)
  warningReason String?  // Human-readable reason for warning
  creatorId     Int?     // CurseForge creator ID (for ban tracking)
  warnedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([modId])
  @@index([creatorId])
  @@map("warned_mods")
}

/// Creators banned due to multiple fake mods
/// Ban triggers after 3+ mods with warnings from same creator
model BannedCreator {
  id              String   @id @default(uuid())
  creatorId       Int      @unique // CurseForge creator/author ID
  creatorName     String   // Creator display name
  modsBannedCount Int      @default(0) // Number of fake mods detected
  bannedAt        DateTime @default(now())

  @@index([creatorId])
  @@map("banned_creators")
}

/// S4MM-style mods folder file index.
/// One row per filesystem inode under the configured Mods root.
/// type: 1 = package, 2 = script, 3 = other (zip/rar/etc.)
model ModIndexFile {
  ino         String   @id
  rootPath    String
  path        String
  mfolder     String   @default("")
  name        String
  type        Int
  minor       Int      @default(-1)
  major       Int      @default(-1)
  casp        Boolean  @default(false)
  cobj        Boolean  @default(false)
  clip        Boolean  @default(false)
  smod        Boolean  @default(false)
  xmlTypes    String   @default("") @map("xml_types")
  merged      Boolean  @default(false)
  recolor     Boolean  @default(false)
  fingerprint Int      @default(-1)
  mtime       Int
  size        Int
  lastCheck   Int      @map("last_check")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entries     ModIndexEntry[]

  @@index([rootPath])
  @@index([type])
  @@index([fingerprint])
  @@index([merged])
  @@index([casp])
  @@map("mod_index_files")
}

/// Resource TGI entries extracted from indexed package files.
model ModIndexEntry {
  id          Int    @id @default(autoincrement())
  ino         String
  type        Int
  group       Int
  instance    String
  instanceHex String @map("instancehex")
  address     String
  file        ModIndexFile @relation(fields: [ino], references: [ino], onDelete: Cascade)

  @@index([ino])
  @@index([address])
  @@index([type])
  @@map("mod_index_entries")
}

/// Key/value metadata for the mods file index (root path, last rebuild, etc.)
model ModIndexMeta {
  key   String @id
  value String

  @@map("mod_index_meta")
}
